{
  "expo": {
    "name": "Spoilancer",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spoilancer",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.mobileproto.xnzlbn",
      "infoPlist": {
        "UIBackgroundModes": [],
        "NSUserNotificationsUsageDescription": "Remind you to log daily expenses on time"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B0E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.mobileproto.xnzlbn",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "READ_SMS",
        "RECEIVE_SMS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0E"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#D4AF37"
        }
      ],
      "expo-transaction-sms-reader"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
